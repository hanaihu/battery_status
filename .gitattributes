# Normalize line endings: store LF in the repository, check out LF everywhere.
# These rules live in the repo so every clone and CI job behaves the same way,
# regardless of each contributor's core.autocrlf setting.
* text=auto eol=lf

# Windows tooling and scripts expect CRLF; LF breaks .bat control flow.
*.bat             text eol=crlf
*.cmd             text eol=crlf
*.ps1             text eol=crlf
*.sln             text eol=crlf
*.vcxproj         text eol=crlf
*.vcxproj.filters text eol=crlf

# Never apply text conversion or diff heuristics to binaries.
*.exe  binary
*.dll  binary
*.lib  binary
*.ico  binary
*.png  binary
*.bmp  binary
